<!-- View/MainWindow.xaml -->

<Window x:Class="BookLibrary.WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека книг" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox Text="{Binding InputTitle}" Width="150" Margin="5" ToolTip="Название книги"/>
            <TextBox Text="{Binding InputAuthor}" Width="150" Margin="5" ToolTip="Автор книги"/>
            <TextBox Text="{Binding InputGenre}" Width="150" Margin="5" ToolTip="Жанр книги"/>
            <TextBox Text="{Binding InputRaiting}" Width="80" Margin="5" ToolTip="Рейтинг книги"/>

            <Button Content="Добавить" Command="{Binding AddBookCommand}" Margin="5"/>
            <Button Content="Удалить" Command="{Binding DeleteBookCommand}" Margin="5"/>
            <Button Content="Обновить" Command="{Binding UpdateBookCommand}" Margin="5"/>
            <Button Content="По автору" Command="{Binding FindByAuthorCommand}" Margin="5"/>
            <Button Content="Группировка" Command="{Binding GroupByAuthorCommand}" Margin="5"/>
            <Button Content="Фэнтези" Command="{Binding FindFantasyBooksCommand}" Margin="5"/>
            <Button Content="По рейтингу" Command="{Binding FindRaitingBooksCommand}" Margin="5"/>
        </StackPanel>

        <!-- Таблица книг -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Raiting}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>